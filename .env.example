# Local development only. Production values are shown in deploy/homelab.env.example.
DB_PATH=./data/homelab.sqlite
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
WOL_BROADCAST=255.255.255.255
WOL_PORT=9
# Optional local IPv4 address of the LAN interface (not its interface name).
WOL_SOURCE_IP=
# Optional in development. Configure both absolute paths to enable SSH status and shutdown.
SSH_IDENTITY_FILE=
SSH_KNOWN_HOSTS_FILE=
SSH_PORT=22

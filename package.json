{
  "name": "jona-homelab",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "packageManager": "pnpm@11.2.0",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "preview": "node --env-file=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "node --test tests/production/*.test.ts"
  },
  "dependencies": {
    "h3": "^1.15.0",
    "jose": "6.2.10",
    "nuxt": "4.5.2",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
